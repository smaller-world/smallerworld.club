  # pkg:gem/playwright-ruby-client#lib/playwright_api/locator_assertions.rb:427
  def to_contain_text(expected, ignoreCase: T.unsafe(nil), timeout: T.unsafe(nil), useInnerText: T.unsafe(nil)); end

