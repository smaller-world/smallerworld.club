  def timestamp; end

  # pkg:gem/playwright-ruby-client#lib/playwright_api/console_message.rb:54
  def type; end

  # The web worker or service worker that produced this console message, if any. Note that console messages from web workers also have non-null [`method: ConsoleMessage.page`].
  #
  # pkg:gem/playwright-ruby-client#lib/playwright_api/console_message.rb:60
  def worker; end
end

