  # @param offset [Integer] offset in the IO/StringIO
  #
  # pkg:gem/rubyzip#lib/zip/input_stream.rb:52
  def initialize(context, dep_offset = T.unsafe(nil), dep_decrypter = T.unsafe(nil), offset: T.unsafe(nil), decrypter: T.unsafe(nil)); end

  # pkg:gem/rubyzip#lib/zip/input_stream.rb:66
  def close; end

  # Returns a Entry object. It is necessary to call this
  # method on a newly created InputStream before reading from
  # the first entry in the archive. Returns nil when there are
  # no more entries.
  #
  # pkg:gem/rubyzip#lib/zip/input_stream.rb:74
  def get_next_entry; end

  # Rewinds the stream to the beginning of the current entry
  #
  # pkg:gem/rubyzip#lib/zip/input_stream.rb:80
  def rewind; end

  # Modeled after IO.sysread
  #
  # pkg:gem/rubyzip#lib/zip/input_stream.rb:90
