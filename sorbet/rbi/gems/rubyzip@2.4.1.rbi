  protected

  # pkg:gem/rubyzip#lib/zip/input_stream.rb:162
  def get_decompressor; end

  # pkg:gem/rubyzip#lib/zip/input_stream.rb:155
  def get_decrypted_io; end

  # pkg:gem/rubyzip#lib/zip/input_stream.rb:124
  def get_io(io_or_file, offset = T.unsafe(nil)); end

  # pkg:gem/rubyzip#lib/zip/input_stream.rb:185
  def input_finished?; end

  # pkg:gem/rubyzip#lib/zip/input_stream.rb:136
  def open_entry; end

  # pkg:gem/rubyzip#lib/zip/input_stream.rb:181
  def produce_input; end

  class << self
    # Same as #initialize but if a block is passed the opened
    # stream is passed to the block and closed when the block
    # returns.
    #
    # pkg:gem/rubyzip#lib/zip/input_stream.rb:98
