  #   The type of this field is +String+.
  # user_id::
  #   The unique ID of the affected User.
  #   The type of this field is +String+.
  # token::
  #   The Magic Link `token` that you'll include in your contact method of choice, e.g. email or SMS.
  #   The type of this field is +String+.
  # status_code::
  #   The HTTP status code of the response. Stytch follows standard HTTP response status code patterns, e.g. 2XX values equate to success, 3XX values are redirects, 4XX are client errors, and 5XX are server errors.
  #   The type of this field is +Integer+.
  #
  # pkg:gem/stytch#lib/stytch/magic_links.rb:171
  def create(user_id:, expiration_minutes: T.unsafe(nil), attributes: T.unsafe(nil)); end

  # pkg:gem/stytch#lib/stytch/magic_links.rb:14
  def email; end
end

