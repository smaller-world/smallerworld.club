  #   The type of this field is nilable +DeviceInfo+ (+object+).
  # intermediate_session_token_expires_at::
  #   (no documentation yet)
  #   The type of this field is nilable +String+.
  #
  # pkg:gem/stytch#lib/stytch/b2b_oauth.rb:145
  def authenticate(oauth_token:, session_token: T.unsafe(nil), session_duration_minutes: T.unsafe(nil), session_jwt: T.unsafe(nil), session_custom_claims: T.unsafe(nil), pkce_code_verifier: T.unsafe(nil), locale: T.unsafe(nil), intermediate_session_token: T.unsafe(nil), telemetry_id: T.unsafe(nil)); end

  # pkg:gem/stytch#lib/stytch/b2b_oauth.rb:14
  def discovery; end
end

# pkg:gem/stytch#lib/stytch/b2b_oauth.rb:172
class StytchB2B::OAuth::Discovery
  include ::Stytch::RequestHelper

