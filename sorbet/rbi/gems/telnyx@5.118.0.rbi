                   # code).
                   # **Required if sending with a phone number, short code, or alphanumeric sender
                   # ID.**
        media_urls: nil, # A list of media URLs. The total media size must be less than 1 MB.
                         # **Required for MMS**
        messaging_profile_id: nil, # Unique identifier for a messaging profile.
