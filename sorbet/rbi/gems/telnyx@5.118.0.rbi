        ).returns(Telnyx::Models::IPConnectionCreateResponse)
      end
      def create(
        active: nil, # Defaults to true
        anchorsite_override: nil, # `Latency` directs Telnyx to route media through the site with the lowest
                                  # round-trip time to the user's connection. Telnyx calculates this time using ICMP
                                  # ping messages. This can be disabled by specifying a site to handle all media.
        android_push_credential_id: nil, # The uuid of the push credential for Android
        call_cost_in_webhooks: nil, # Specifies if call cost webhooks should be sent for this connection.
        connection_name: nil,
        default_on_hold_comfort_noise_enabled: nil, # When enabled, Telnyx will generate comfort noise when you place the call on
                                                    # hold. If disabled, you will need to generate comfort noise or on hold music to
                                                    # avoid RTP timeout.
        dtmf_type: nil, # Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF
                        # digits sent to Telnyx will be accepted in all formats.
        encode_contact_header_enabled: nil, # Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG
                                            # scenarios.
        encrypted_media: nil, # Enable use of SRTP for encryption. Cannot be set if the transport_portocol is
                              # TLS.
        inbound: nil,
        ios_push_credential_id: nil, # The uuid of the push credential for Ios
        jitter_buffer: nil, # Configuration options for Jitter Buffer. Enables Jitter Buffer for RTP streams
                            # of SIP Trunking calls. The feature is off unless enabled. You may define min and
                            # max values in msec for customized buffering behaviors. Larger values add latency
                            # but tolerate more jitter, while smaller values reduce latency but are more
                            # sensitive to jitter and reordering.
        noise_suppression: nil, # Controls when noise suppression is applied to calls. When set to 'inbound',
                                # noise suppression is applied to incoming audio. When set to 'outbound', it's
                                # applied to outgoing audio. When set to 'both', it's applied in both directions.
                                # When set to 'disabled', noise suppression is turned off.
        noise_suppression_details: nil, # Configuration options for noise suppression. These settings are stored
                                        # regardless of the noise_suppression value, but only take effect when
                                        # noise_suppression is not 'disabled'. If you disable noise suppression and later
                                        # re-enable it, the previously configured settings will be used.
        onnet_t38_passthrough_enabled: nil, # Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly
                                            # if both are on the Telnyx network. If this is disabled, Telnyx will be able to
                                            # use T38 on just one leg of the call depending on each leg's settings.
        outbound: nil,
        rtcp_settings: nil,
        tags: nil, # Tags associated with the connection.
        transport_protocol: nil, # One of UDP, TLS, or TCP. Applies only to connections with IP authentication or
