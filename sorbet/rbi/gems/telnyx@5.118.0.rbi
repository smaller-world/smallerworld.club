                             # connect.
        cloud_provider_region: nil, # The region where your Virtual Private Cloud hosts are located.<br /><br />The
                                    # available regions can be found using the /virtual_cross_connect_regions
                                    # endpoint.
        name: nil, # A user specified name for the interface.
