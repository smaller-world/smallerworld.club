              trim: nil, # Body param: Whether to trim any leading and trailing silence from the recording.
                         # Defaults to `trim-silence`.
              wait_url: nil, # Body param: The URL to call for an audio file to play while the participant is
                             # waiting for the conference to start.
              request_options: {}
