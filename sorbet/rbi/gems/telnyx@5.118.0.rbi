        aws: nil, # AWS Polly provider-specific parameters.
        azure: nil, # Azure Cognitive Services provider-specific parameters.
        disable_cache: nil, # When `true`, bypass the audio cache and generate fresh audio.
        elevenlabs: nil, # ElevenLabs provider-specific parameters.
        language: nil, # Language code (e.g. `en-US`). Usage varies by provider.
        minimax: nil, # Minimax provider-specific parameters.
        output_type: nil, # Determines the response format. `binary_output` returns raw audio bytes,
                          # `base64_output` returns base64-encoded audio in JSON.
        provider: nil, # TTS provider. Required unless `voice` is provided.
        resemble: nil, # Resemble AI provider-specific parameters.
        rime: nil, # Rime provider-specific parameters.
        telnyx: nil, # Telnyx provider-specific parameters. Use `voice_speed` and `temperature` for
