            preferred_codecs: Telnyx::Calls::ActionAnswerParams::PreferredCodecs::OrSymbol,
            record: Telnyx::Calls::ActionAnswerParams::Record::OrSymbol,
            record_channels: Telnyx::Calls::ActionAnswerParams::RecordChannels::OrSymbol,
