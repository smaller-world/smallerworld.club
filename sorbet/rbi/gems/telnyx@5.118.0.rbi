          stream_track: nil, # Specifies which track should be streamed.
          stream_url: nil, # The destination WebSocket address where the stream is going to be delivered.
          transcription: nil, # Enable transcription upon call answer. The default value is false.
          transcription_config: nil,
          webhook_retries_policies: nil, # A map of event types to retry policies. Each retry policy contains an array of
