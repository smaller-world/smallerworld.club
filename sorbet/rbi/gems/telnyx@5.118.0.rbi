                                  # all media.
        call_cost_in_webhooks: nil, # Specifies if call cost webhooks should be sent for this Call Control
                                    # Application.
        dtmf_type: nil, # Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF
