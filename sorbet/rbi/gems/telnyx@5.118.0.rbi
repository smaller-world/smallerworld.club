                                    # hangup after timing out.
        first_command_timeout_secs: nil, # Specifies how many seconds to wait before timing out a dial command.
        inbound: nil,
        outbound: nil,
        redact_dtmf_debug_logging: nil, # When enabled, DTMF digits entered by users will be redacted in debug logs to
