# pkg:gem/http-2#lib/http/2/header/decompressor.rb:12
class HTTP2::Header::Decompressor
  include ::HTTP2::Error
  include ::HTTP2::BufferUtils

  # @param options [Hash] decoding options.  Only :table_size is effective.
  #
