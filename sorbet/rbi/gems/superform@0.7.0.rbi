# The `Field` class is nested inside the `Form` class so it can be easily extended
# to customize the form inputs for your application. For example, if you wanted to
# add some default classes to all your inputs and labels you could do something like:
#
# ```ruby
# class MyForm < Superform::Rails::Form
#   class Field < self::Field
#     def input(**attributes)
#       super(class: "input input-bordered", **attributes)
#     end
#
#     def label(**attributes, &block)
#       super(class: "label", **attributes, &block)
#     end
#   end
# end
# ```
#
# pkg:gem/superform#lib/superform/rails/form.rb:34
Superform::Rails::Form::Field = Superform::Rails::Field

# When this is included in a Rails app, check if `Components::Base` is defined and
# inherit from that so we get all the users stuff; otherwise inherit from Phlex::HTML,
# which means we won't have all the users methods and overrides.
#
# pkg:gem/superform#lib/superform/rails.rb:8
Superform::Rails::SUPERCLASSES = T.let(T.unsafe(nil), Array)

# pkg:gem/superform#lib/superform/rails/strong_parameters.rb:3
module Superform::Rails::StrongParameters
  protected

  # Assigns params to the form and returns the form.
  #
  # pkg:gem/superform#lib/superform/rails/strong_parameters.rb:60
  def assign(params, to:); end

  # Assigns permitted params to the given form and returns the model.
  # Usage in a controller when you want to build/validate without saving:
  #
  # def preview
  #   @post = Post.new
  #   post = permit PostForm.new(@post)
  #   # post now has attributes from params, but is not persisted
  #   render :preview
  # end
  #
  # pkg:gem/superform#lib/superform/rails/strong_parameters.rb:14
  def permit(form); end

  # Saves the form's underlying model after assigning permitted params.
  # Typical Rails controller usage (create):
  #
  # def create
  #   @post = Post.new
  #   if save PostForm.new(@post)
  #     redirect_to @post
  #   else
  #     render :new, status: :unprocessable_entity
  #   end
  # end
  #
  # Typical Rails controller usage (update):
  #
  # def update
  #   @post = Post.find(params[:id])
  #   if save PostForm.new(@post)
  #     redirect_to @post
  #   else
  #     render :edit, status: :unprocessable_entity
  #   end
  # end
  #
  # pkg:gem/superform#lib/superform/rails/strong_parameters.rb:41
  def save(form); end

  # Bang version that raises on validation failure.
  # Useful when you prefer exceptions or are in a transaction:
  #
  # def create
  #   @post = Post.new
  #   save! PostForm.new(@post)
  #   redirect_to @post
  # rescue ActiveRecord::RecordInvalid
  #   render :new, status: :unprocessable_entity
  # end
  #
  # pkg:gem/superform#lib/superform/rails/strong_parameters.rb:55
  def save!(form); end
end

