{
  "compilerOptions": {
    // == Paths
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*"]
    },

    // == Language
    "module": "ESNext",
    "target": "ESNext",
    "types": [
      "node",
      "vite/client",
      "unplugin-icons/types/react",
      "cloudflare-turnstile"
    ],
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,

    // == Mode
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "incremental": true,
    "jsx": "preserve",
    "noEmit": true,

    // == Linting
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "typings/**/*.d.ts"],
  "exclude": [
    "app/entrypoints/sw.ts",
    "typings/service-worker.d.ts",
    "typings/generated/**/*.d.ts"
  ],
  "references": [{ "path": "./tsconfig.service-worker.json" }]
}
