{
  "settings": {},
  "rules": [
    {
      "patterns": ["^\/home$"],
      "properties": {
        "presentation": "replace_root"
      }
    },
    {
      "patterns": [
        "\/new(\\?.*)?$",
        "\/edit(\\?.*)?$",
        "^\/world_key_grants\/.+$",
        "^\/world_cards\/[\\w-]+\/key_grant(\\?.*)?$",
        "\/settings(\\?.*)?$",
        "\/policies(\\?.*)?$",
        "\/contact(\\?.*)?$"
      ],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": ["^\/session\/new(\\?.*)?$", "^\/account\/new(\\?.*)?$"],
      "properties": {
        "context": "default",
        "presentation": "replace_root",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": ["\/posts\/new(\\?.*)?$", "^\/posts\/[\\w-]+\/edit$"],
      "properties": {
        "query_string_presentation": "replace"
      }
    },
    {
      "patterns": ["^\/worlds\/[\\w-]+(\\?.*)?$"],
      "properties": {
        "query_string_presentation": "replace"
      }
    },
    {
      "patterns": [
        "^\/world_keys\/[\\w-]+\/edit$",
        "^\/worlds\/[\\w-]+\/post_types/new$",
        "^\/post_types\/[\\w-]+\/edit$"
      ],
      "properties": {
        "uri": "hotwire://fragment/web/modal/sheet"
      }
    },
    {
      "patterns": ["^\/native\/scan_qr_code$"],
      "properties": {
        "native_screen": "qr_code_scanner"
      }
    },
    {
      "patterns": [
        "^\/worlds$",
        "^\/world_key_grants$",
        "^\/world_cards$",
        "^\/world_cards\/[\\w-]+$"
      ],
      "properties": {
        "unroutable": true
      }
    }
  ]
}
