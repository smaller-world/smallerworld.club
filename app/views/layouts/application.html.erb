<!DOCTYPE html>

<%= tag.html lang: "en", data: { hotwire_native: hotwire_native_data_attribute } do %>
  <head>
    <%# == Meta tags == %>

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    >

    <meta name="view-transition" content="same-origin">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="env" content="<%= Rails.env %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# == Turbo == %>

    <%# turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%# = tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# == Favicons == %>

    <link rel="shotcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link
      rel="icon"
      href="/favicon-96x96.png"
      type="image/png"
      sizes="96x96"
    >

    <%# == Application assets == %>

    <%= vite_typescript_tag "application", data: { turbo_track: "reload" } %>
    <%= vite_stylesheet_tag "application", data: { turbo_track: "reload" } %>

    <% if Rails.env.development? %>
      <%= vite_typescript_tag "devtools", data: { turbo_track: "reload" } %>
    <% end %>

    <%# == Fonts == %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Manrope:wght@200..800&family=Single+Day&display=swap"
      rel="stylesheet"
    >

    <%# == Vite == %>

    <%= vite_client_tag %>

    <%# == Turnstile == %>

    <% if (turnstile = Turnstile.settings) %>
      <meta name="turnstile-site-key" content="<%= turnstile.site_key %>">
    <% end %>

    <%# == Other head content == %>

    <% if title = page_title %>
      <title><%= title %></title>
    <% end %>

    <%= yield :head %>
  </head>

  <body>
    <header class="app_header"><%= render "layouts/app_menu" %></header>

    <main class="app_main"><%= render "layouts/flash" %><%= yield %></main>

    <div id="notifications"></div>

    <%= yield :scripts %>
  </body>
<% end %>
