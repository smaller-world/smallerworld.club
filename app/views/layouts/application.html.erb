<!DOCTYPE html>
<%= tag.html lang: "en", data: { hotwire_native: hotwire_native_data_attribute } do %>
  <head>
    <%# == Meta tags == %>

    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
    <meta name="view-transition" content="same-origin">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="env" content="<%= Rails.env %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# == Favicons == %>

    <link rel="shotcut icon" href="/favicon.ico">
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# == Application assets == %>

    <%= vite_typescript_tag "application", "data-turbo-track": "reload" %>
    <%= vite_stylesheet_tag "application", "data-turbo-track": "reload" %>

    <%# == Fonts == %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Manrope:wght@200..800&display=swap" rel="stylesheet">

    <%# == Vite == %>

    <%= vite_client_tag %>

    <%# == Other head content == %>

    <% if title = page_title %>
      <title><%= title %></title>
    <% end %>
    <%= yield :head %>
  </head>

  <body>
    <header>
      <%= link_to web_start_path, class: "flex items-center gap-1 rounded-3xl hover:bg-primary-100 py-1 pl-2 pr-3" do %>
        <%= vite_image_tag "assets/images/logo.png", class: "size-6" %>
        <span class="font-headings font-bold">smaller world</span>
      <% end %>
    </header>
    <%= turbo_frame_tag :flash do %>
    <% if notice = flash[:notice] || flash[:alert] %>
        <div class="flash" data-controller="element-removal" data-action="animationend->element-removal#remove">
          <div class="flash-inner">
            <%= notice %>
          </div>
        </div>
      <% end %>
    <% end %>
    <main>
      <%= yield %>
    </main>
  </body>
<% end %>
