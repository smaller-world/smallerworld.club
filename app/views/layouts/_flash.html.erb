<%- notice = flash[:notice] -%>
<%- alert = flash[:alert] -%>

<%= turbo_frame_tag :flash, class: "contents" do %>
  <% if (message = (notice || alert)) %>
    <%= tag.div(
      class: class_names("card flash", "flash-alert": alert.present?),
    ) do %>
      <%= message %>
    <% end %>
  <% end %>
<% end %>
