<div class="page_container flex flex-col gap-6">
  <%= back_link_to(
    "your world",
    [:user, :world, emulate_native_app: 1],
    class: "self-center",
  ) %>

  <%= link_to(
    [:user, :world, :friends, action: :invite],
    class: "btn btn-outline self-center",
  ) do %>
    <%= icon "user-plus", class: "size-5" %>
    <span>invite a friend!</span>
  <% end %>

  <ul class="space-y-2.5">
    <% @friends.each do |friend| %>
      <li><%= render "users/worlds/friends/card", friend: friend %></li>
    <% end %>
  </ul>
</div>
