<%= turbo_frame_tag dom_id(@space, :new), class: "block max-w-xl mx-auto p-4" do %>
  <%= form_with(
    model: @space,
    url: user_spaces_path,
    class: "flex flex-col gap-4",
    data: {
      turbo_frame: "_top",
      controller: "prevent-submit-while-busy",
    }
  ) do |form| %>
    <%= render(
      "forms/text_field",
      form:,
      name: :name,
      label: "your space's name",
      placeholder: "new stadium",
      required: true,
    ) %>
    <%= render(
      "forms/text_area",
      form:,
      name: :description,
      label: "purpose",
      description: "what do people write about in this space?",
      placeholder: "a space to share project progress updates",
      required: true,
      class: "min-h-24",
    ) %>
    <%= render(
      "forms/icon_field",
      form:,
      name: :icon,
      label: "icon (optional)",
      accept: "image/png, image/jpeg, image/jpg, image/gif, image/webp, image/heic, image/heif",
      center: true,
    ) %>
    <div class="flex gap-1.5 items-center">
      <%= form.check_box :public, class: "form-checkbox" %>
      <%= form.label :public, "show on spaces tab for all users", class: "text-sm" %>
    </div>
    <%= form.button type: "submit", class: "btn" do %>
      <span>create space</span>
    <% end %>
  <% end %>
<% end %>
