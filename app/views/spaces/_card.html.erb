<%= tag.div(
  id: dom_id(space, :card),
  class: class_names("card flex gap-4", local_assigns[:class])
) do %>
  <% if space.icon.attached? %>
    <%= image_tag(
      space.icon.variant(:page_icon),
      class: "rounded-app-icon size-20",
    ) %>
  <% end %>

  <div class="flex flex-1 flex-col gap-y-0.5">
    <p class="font-headings text-lg leading-tight font-semibold">
      <%= space.name %>
    </p>

    <p class="text-shade-500 leading-tight"><%= space.description %></p>
  </div>
<% end %>
