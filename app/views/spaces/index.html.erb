<div class="page-container flex flex-col gap-6">
  <div class="flex flex-col gap-2">
    <h2 class="mb-1 text-center text-2xl font-medium">spaces you created</h2>

    <% if @owned_spaces.any? %>
      <ul class="space-y-3">
        <% @owned_spaces.each do |space| %>
          <li>
            <%= link_to(
              space_path(space, emulate_native_app: 1),
              class: "block rounded-3xl"
            ) do %>
              <%= render "spaces/card", space: %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-shade-400 text-center text-sm">
        you haven&apos;t created any spaces yet :<
        <br>
        (but maybe you should try it..)
      </p>
    <% end %>

    <%= link_to new_space_path, class: "btn mt-1", ontouchstart: "" do %>
      <%= icon "user-group", options: { class: "size-5" } %>
      <span> create a space </span>
    <% end %>
  </div>

  <% if @posted_spaces.any? %>
    <div class="flex flex-col gap-2">
      <h1 class="mb-1 text-center text-2xl font-medium">
        spaces you posted in
      </h1>

      <ul class="space-y-3">
        <% @posted_spaces.each do |space| %>
          <li>
            <%= link_to(
              space_path(space, emulate_native_app: 1),
              class: "block rounded-3xl"
            ) do %>
              <%= render "spaces/card", space: %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
