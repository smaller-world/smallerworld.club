<div class="page-container flex flex-col gap-6">
  <%= back_link_to(
    @space.name,
    space_path(@space, post_id: @post.id, emulate_native_app: 1),
  ) do %>
    <%= icon "arrow-uturn-left", variant: :micro, class: "size-5" %>
    <span class="overflow-ellipsis">back to <%= @space.name %></span>
  <% end %>

  <%= turbo_frame_tag dom_id(@post, :edit), target: "_top" do %>
    <%= render "spaces/posts/form", post: @post %>
  <% end %>
</div>
