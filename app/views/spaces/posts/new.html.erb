<div class="page_container flex flex-col gap-6">
  <%= back_link_to(
    @space.name,
    space_path(@space, emulate_native_app: 1),
    class: "self-center",
  ) %>

  <%= turbo_frame_tag dom_id(@post, :new), target: "_top" do %>
    <%= render "spaces/posts/form", post: @post %>
  <% end %>
</div>
