<div class="max-w-xl mx-auto p-4 flex flex-col gap-6">
  <%= back_link_to "your spaces", spaces_path %>
  <div class="flex flex-col gap-3">
    <% if @space.icon.attached? %>
      <%= image_tag @space.icon, class: "self-center rounded-app-icon size-28" %>
    <% end %>
    <div class="flex flex-col gap-0.5">
      <div class="flex flex-row items-start justify-between gap-1">
        <div class="w-9"></div>
        <h1 class="text-2xl font-semibold text-center">
          <%= @space.name %>
        </h1>
        <%= link_to edit_space_path(@space), class: "btn p-1 rounded-full" do %>
          <%= icon "cog-6-tooth", variant: :solid, class: "size-6" %>
        <% end %>
      </div>
      <p class="text-sm text-shade-500 text-center">
        <%= @space.description %>
      </p>
    </div>
  </div>
  <%= turbo_frame_tag dom_id(@space, :posts), target: "_top" do %>
    <% if @posts.any? %>
      <ul class="space-y-3">
        <% @posts.each do |post| %>
          <li>
            <%= render "posts/card", post: %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-center text-shade-400">
        this space doesn&apos;t have any posts yet <span class="ml-1">:<</span>
        <br>
        (maybe you should do something about that...)
      </p>
    <% end %>
  <% end %>
</div>
