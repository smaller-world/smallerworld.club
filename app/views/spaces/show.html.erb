<div class="page_container flex flex-col gap-6">
  <%= back_link_to "your spaces", spaces_path, class: "self-center" %>

  <div class="flex flex-col gap-3">
    <% if @space.icon.attached? %>
      <%= image_tag(
        @space.icon.variant(:page_icon),
        class: class_names(
          "rounded-app-icon object-cover size-28 shadow-lg cursor-copy",
          "self-center",
        ),
        data: {
          controller: "clipboard haptic-bridge tooltip",
          action: class_names(
            "click->clipboard#copy",
            "clipboard:copied->haptic-bridge#vibrate",
            "clipboard:copied->tooltip#flash",
          ),
          clipboard_copy_value: space_url(@space, emulate_native_app: 1),
          tooltip_trigger_value: "manual",
          tooltip_content_value: "space link copied!",
          tooltip_flash_duration_value: 1400,
        },
      ) %>
    <% end %>

    <div class="flex flex-col gap-0.5">
      <div class="flex flex-row items-start gap-1">
        <% if allowed_to?(:edit?, @space) %>
          <div class="with-button-bridge:hidden w-9"></div>
        <% end %>

        <h1 class="flex-1 text-center text-2xl font-semibold">
          <%= @space.name %>
        </h1>

        <% if allowed_to?(:edit?, @space) %>
          <%= link_to(
            edit_space_path(@space),
            class: "btn p-1 rounded-full with-button-bridge:hidden",
            aria: {
              label: "space settings"
            },
            data: {
              controller: "button-bridge",
              bridge_title: "settings",
              bridge_ios_image: "gearshape.fill",
            },
          ) do %>
            <%= icon "cog-6-tooth", variant: :solid, class: "size-6" %>
          <% end %>
        <% end %>
      </div>

      <%= tag.p(
        @space.description,
        class: "text-shade-500 text-center text-sm whitespace-pre-line",
      ) %>
    </div>
  </div>

  <div class="flex flex-col gap-3">
    <% if hotwire_native_app? && !current_native_device %>
      <%= render(
        "native_devices/form",
        class: "self-center",
        button: {
          data: {
            tooltip_content_value: "hear about happenings in this space!",
            tooltip_trigger_value: "manual",
            tooltip_flash_immediately_value: true,
            tooltip_flash_delay_value: 1000,
          },
        },
      ) %>
    <% end %>

    <%= render "spaces/posts/new", space: @space, class: "mb-3" %>

    <ul id="<%= dom_id(@space, :posts) %>" class="space-y-4">
      <% @posts.each do |post| %>
        <li><%= render "posts/card", post: %></li>
      <% end %>
    </ul>

    <% if (page = @pagy.next) %>
      <%= render "spaces/posts/pagination_button", space: @space, page: %>
    <% end %>

    <% if @posts.none? %>
      <p class="text-shade-400 text-center text-sm">
        this space doesn&apos;t have any posts yet <span class="ml-1">:<</span>
        
        <br>
        (maybe you should do something about that...)
      </p>
    <% end %>
  </div>
</div>
