<% class_name = local_assigns.delete(:class) %>

<%= form_with(
  model: space,
  class: class_names("flex flex-col gap-4", class_name),
  data: {
    controller: "busy-reporter haptic-bridge",
    action: "turbo:submit-end->haptic-bridge#vibrate",
  }
) do |form| %>
  <%= render(
    "forms/text_field",
    form:,
    name: :name,
    label: "your space's name",
    placeholder: "new stadium",
    required: true,
  ) %>

  <%= render(
    "forms/text_area",
    form:,
    name: :description,
    label: "purpose",
    description: "what do people write about in this space?",
    placeholder: "a space to share project progress updates",
    required: true,
    class: "min-h-24",
  ) %>

  <%= render(
    "forms/icon_field",
    form:,
    name: :icon,
    label: "icon (optional)",
    accept: "image/png, image/jpeg, image/jpg, image/webp, image/heic, image/heif",
    center: true,
  ) %>

  <% if current_user.admin? %>
    <fieldset class="card pt-1.5">
      <legend class="dark:bg-shade-900 w-fit bg-white px-2 text-center font-medium">
        advanced settings
      </legend>

      <div class="flex items-center gap-2">
        <%= form.check_box :public, class: "form-checkbox" %>

        <%= form.label(
          :public,
          "show on spaces tab for all users",
          class: "text-sm leading-tight"
        ) %>
      </div>
    </fieldset>
  <% end %>

  <%= form.button(
    type: "submit",
    class: "btn btn-action",
    ontouchstart: "",
  ) do %>
    <span><%= space.new_record? ? "create space" : "save changes" %></span>

    <% if space.new_record? %>
      <%= icon "arrow-right", variant: :micro, class: "size-5" %>
    <% end %>
  <% end %>
<% end %>
