<%= tag.div(
  id: dom_id(friend, :card),
  class: class_names("card flex gap-2 justify-between", local_assigns[:class])
) do %>
  <div class="flex items-baseline gap-2 text-lg">
    <% if friend.emoji %>
      <span class="font-emoji"><%= friend.emoji %></span>
    <% end %>

    <span class="font-medium"><%= friend.name %></span>
  </div>

  <% if friend.paused? %>
    <div class="badge">
      <%= icon "pause", class: "size-3.5" %>
      <span>paused</span>
    </div>
  <% elsif friend.notifiable? %>
    <div class="badge">
      <%= icon "device-phone-mobile", class: "size-3.5" %>
      <span>installed</span>
    </div>
  <% elsif friend.phone_number? %>
    <div class="badge">
      <%= icon "chat-bubble-bottom-center-text", class: "size-3.5" %>
      <span>texts only</span>
    </div>
  <% end %>
<% end %>
