<div
  class="
    page_container max-w-md w-full flex flex-col justify-center items-center
    gap-y-6
  "
>
  <% if @post_shares.present? %>
    <h1 class="text-2xl font-medium text-center">
      <% if @post_shares.one? %>
        you found a secret!
      <% else %>
        you found some secrets!
      <% end %>
    </h1>
    <ul class="space-y-2 self-stretch">
      <% @post_shares.each do |post_share| %>
        <%= link_to(post_share_path(post_share), class: "block") do %>
          <li class="card px-4 py-2 flex flex-col gap-y-0.5">
            <div class="font-semibold"><%= post_share.post.fun_title %></div>

            <div class="text-sm"><%= post_share.post.body_snippet %></div>

            <div class="text-shade-500 text-sm">
              <%= post_share.post.author!.name %>
            </div>
          </li>
        <% end %>
      <% end %>
    </ul>
  <% else %>
    <div class="flex flex-col items-center gap-y-4">
      <%= vite_image_tag "assets/images/logo.png", class: "size-14" %>

      <h1 class="text-2xl font-medium text-center text-shade-600">
        could it be...
        <br>
        that someone's <span class="font-bold text-black">secret</span>
        <br>
        is buried nearby?
      </h1>
    </div>
    <%= form_with(
      url: find_secrets_path,
      method: :post,
      data: {
        controller: "locate form",
        action: "locate:located->form#submit",
      },
    ) do |f| %>
      <%= f.hidden_field :secret_location, data: { locate_target: "input" } %>

      <div class="flex flex-col items-center gap-y-2">
        <%= f.button(
          class: "btn btn-action gap-x-2.5",
          data: {
            action: "click->locate#locate:prevent",
          },
        ) do %>
          <%= icon "binoculars", library: :phosphor, class: "size-5", fill: "currentColor" %>
          <span class="text-xl">find out</span>
        <% end %>

        <% if !@post_shares.nil? && @post_shares.empty? %>
          <div class="text-error-500 text-center">
            didn't find any secrets nearby :(
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <a
    href="https://app.addtowallet.co/card/69c03ab17c18b27ab894919b"
    class="link text-xs underline"
  >
    get notified when you're near a secret!
  </a>
</div>

<footer
  style="position: fixed; bottom: 0; width: 100%;
padding-bottom: 0.5em; font-size: 1vw;"
>
  <p>
    This is a <a href="https://sundaysites.cafe/">Sunday Site</a> made by
    <a href="https://sundaysites.cafe/~itskai"> itskai</a>.
  </p>
</footer>
