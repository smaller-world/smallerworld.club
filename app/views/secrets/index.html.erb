<div class="page_container max-w-md w-full flex flex-col flex-1">
  <div class="flex-1 flex flex-col justify-center gap-y-6">
    <div class="flex flex-col items-center gap-y-4">
      <%= vite_image_tag "assets/images/logo.png", class: "size-14" %>

      <h1 class="text-2xl font-medium text-center">
        <% if @post_shares.blank? %>
          <span class="text-shade-600 dark:text-shade-400">
            could it be...
            <br>
            that someone's
            <span class="font-bold text-shade-contrast">secret</span>
            <br>
            is buried nearby?
          </span>
        <% elsif @post_shares.one? %>
          you found a secret!!
        <% else %>
          you found secrets!!
        <% end %>
      </h1>
    </div>

    <% if @post_shares.present? %>
      <ul class="space-y-2 self-stretch">
        <% @post_shares.each do |post_share| %>
          <% post = post_share.post! %>

          <%= link_to(post_share_path(post_share), class: "block") do %>
            <li class="card px-4 py-2 flex flex-col gap-y-0.5">
              <div>
                <div class="font-semibold"><%= post.fun_title %></div>

                <div class="text-sm"><%= post.body_snippet %></div>
              </div>

              <div class="text-shade-500 text-sm">
                from <%= post.author!.name %>
              </div>
            </li>
          <% end %>
        <% end %>
      </ul>
    <% end %>

    <%= form_with(
      url: secrets_path,
      method: :get,
      data: {
        controller: "locate form",
        action: "locate:located->form#submit",
      },
    ) do |f| %>
      <%= f.hidden_field :near, data: { locate_target: "input" } %>

      <div class="flex flex-col items-center gap-y-4">
        <%= f.button(
          class: "btn btn-action gap-x-2.5",
          name: nil,
          data: {
            action: "click->locate#locate:prevent",
          },
        ) do %>
          <% if @post_shares.nil? %>
            <%= icon "binoculars", library: :phosphor, class: "size-5", fill: "currentColor" %>
            <span class="text-xl">find out</span>
          <% else %>
            <%= icon "arrow-path", class: "size-5" %>
            <span>refresh location</span>
          <% end %>
        <% end %>

        <% if !@post_shares.nil? && @post_shares.empty? %>
          <div class="text-error-500 text-center">
            didn't find any secrets nearby :(
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @os_name.in?(%w[Android iOS]) %>
    <%= link_to(
      card_secrets_path,
      class:"link text-xs underline self-center"
    ) do %>
      <% if @os_name == "Android" %>
        <%= image_tag("add_to_google_wallet_badge.svg", class: "w-44") %>
      <% else %>
        <%= image_tag("add_to_apple_wallet_badge.svg", class: "w-44") %>
      <% end %>
    <% end %>
  <% end %>
</div>
