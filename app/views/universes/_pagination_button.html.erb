<%= button_to(
  [:universe, :worlds],
  method: :get,
  class: "btn",
  form: {
    id: "pagination",
    class: "self-center overflow-anchor-none",
  },
  params: { page: },
  data: {
    controller: "click-on-appear",
    action: "click-on-appear:appear->click-on-appear#click",
    turbo_stream: true,
  },
) do %>
  <span class="text-xs">see more worlds...</span>
<% end %>
