<div class="page_container flex flex-col gap-6 native:pt-0">
  <% if hotwire_native_app? %>
    <a href="/scan_qr_code" class="btn btn-outline self-center py-1">
      <%= icon "qr-code", class: "size-5" %>
      <span>join a world</span>
    </a>
  <% end %>

  <div>
    <ul id="worlds" class="universe_grid">
      <% @worlds.each do |world| %>
        <%= render(
          "universes/world",
          world:,
          friend_token: world[:friend_token],
        ) %>
      <% end %>
    </ul>
  </div>

  <% if (page = @pagy.next) %>
    <%= render "universes/pagination_button", page: %>
  <% end %>
</div>
