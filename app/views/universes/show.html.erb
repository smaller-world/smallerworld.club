<div class="page_container flex flex-col gap-6">
  <h1 class="text-2xl font-bold text-center">your smaller universe</h1>

  <ul class="flex flex-wrap items-center gap-4">
    <% @worlds.each do |world| %>
      <li>
        <%= link_to(
          world_path(world),
          class: "flex flex-col items-center gap-2 hover:underline",
        ) do %>
          <%= image_tag(
            world.icon.variant(:page_icon),
            class: "self-center rounded-app-icon size-24 shadow-lg object-cover"
          ) %>

          <p class="font-medium text-sm font-headings"><%= world.name %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
