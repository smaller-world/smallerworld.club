<div class="page_container flex flex-col gap-6">
  <ul class="flex flex-wrap justify-around gap-4">
    <% @worlds.each do |world| %>
      <li>
        <%= link_to(
          if allowed_to?(:manage?, world)
            user_world_path(emulate_native_app: 1)
          else
            world_path(
              world,
              friend_token: @access_tokens_by_world_id[world.id],
              emulate_native_app: 1
            )
          end,
          class: "flex flex-col items-center gap-2 hover:underline",
        ) do %>
          <%= image_tag(
            world.icon.variant(:page_icon),
            class: "self-center rounded-app-icon size-20 shadow-lg object-cover"
          ) %>

          <p class="font-medium text-sm font-headings"><%= world.name %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
