<%- content_for :head do -%>
  <link rel="preconnect" href="https://challenges.cloudflare.com">
<%- end -%>

<%- content_for :scripts do -%>
  <script>
    window.onTurnstileAPIReady = function() {
      window.dispatchEvent(new Event("turnstile:api-ready"));
    };
  </script>

  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileAPIReady"
    async
    defer
  ></script>
<%- end -%>

<div class="page_container flex max-w-sm flex-1 flex-col justify-center gap-5">
  <%= vite_image_tag "assets/images/logo.png", class: "size-14 self-center" %>

  <h1 class="text-center text-3xl leading-tight font-bold">
    <span class="text-shade-dimmed"> get into</span>
    <span class="text-shade-contrast">smaller world</span>
  </h1>

  <%= form_with(
    model: @login_request,
    url: (session_path if @login_request.persisted?),
    method: :post,
    class: "flex flex-col gap-6",
    data: {
      controller: "form",
      action: (
        class_names(
          "turnstile:success@window->form#enable",
          "turnstile:expired@window->form#disable",
          "turnstile:error@window->form#disable",
        ) if TurnstileService.enabled?
      ),
    }
  ) do |form| %>
    <%= render(
      "forms/phone_number_field",
      form:,
      field: :phone_number,
      label: nil,
      placeholder: "enter your phone #...",
      required: true,
      autofocus: true,
      country_code_input: {
        class: "form_input-lg",
      },
      national_number_input: {
        class: "form_input-lg",
      },
    ) %>

    <div class="flex flex-col gap-2">
      <% if (turnstile = Turnstile.settings) %>
        <div
          data-controller="turnstile"
          data-turnstile-site-key-value="<%= turnstile.site_key %>"
        ></div>
      <% end %>

      <%= form.button(
        class: "btn btn-action self-center",
        disabled: TurnstileService.enabled?,
      ) do %>
        <%= icon "device-phone-mobile", variant: :micro, class: "size-5" %>
        <span>send login code</span>
      <% end %>
    </div>
  <% end %>

  <div
    class="
      text-shade-400 dark:text-shade-500 max-w-60 self-center text-center
      text-xs leading-tight
    "
  >
    by continuing, you agree to receive sms messages from
    <span class="font-medium">smaller world</span>
  </div>

  <div class="h-14"></div>
</div>
