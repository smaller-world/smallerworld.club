<%= form_with(
  model: login_request,
  url: (session_path if login_request.persisted?),
  method: :post,
  id: dom_id(LoginRequest.new),
  class: "flex flex-col gap-6",
) do |form| %>
  <div class="flex flex-col gap-4">
    <%= render(
      "forms/phone_number_field",
      form:,
      name: :phone_number,
      label: "your phone #",
      required: true,
    ) %>

    <% if login_request.persisted? %>
      <%= render(
        "forms/otp_field",
        form:,
        name: :login_code,
        description: "enter the code sent to your phone",
        value: (login_request.login_code if Rails.env.development?),
        required: true,
        otp_container: {
          data: {
            controller: class_names(tooltip: Rails.env.development?),
            tooltip_content_value: "(auto-filled during development)",
            tooltip_trigger_value: "manual",
            tooltip_flash_immediately_value: true,
            tooltip_flash_duration_value: 1600,
            tooltip_flash_delay_value: 200,
            tooltip_placement_value: "bottom-start",
          },
        },
      ) %>
    <% end %>
  </div>

  <div class="flex flex-col gap-3">
    <%= form.button class: "btn btn-action self-center" do %>
      <% if login_request.persisted? %>
      <% else %>
        <%= icon "device-phone-mobile", variant: :micro, class: "size-5" %>
        <span>send login code</span>
      <% end %>
    <% end %>

    <% unless login_request.persisted? %>
      <div
        class="
          text-shade-400 dark:text-shade-500 max-w-60 self-center
          text-center text-xs leading-tight
        "
      >
        by continuing, you agree to receive sms messages from
        <span class="font-medium">smaller world</span>
      </div>
    <% end %>
  </div>
<% end %>
