<% class_name = local_assigns.delete(:class) %>

<%= tag.div(
  id: dom_id(post, :card),
  class: class_names("card post-card", class_name),
  data: {
    controller: "busy-reporter",
  },
) do %>
  <div class="flex flex-col gap-1">
    <div class="post-card-header">
      <div class="flex items-baseline gap-1">
        <span class="inline-flex items-baseline gap-1">
          <% if (emoji = post.emoji) %>
            <span class="font-emoji relative top-px mr-px text-sm">
              <%= emoji %>
            </span>
          <% else %>
            <%= post_type_icon(post.type, class: "size-3 self-center") %>
          <% end %>

          <span class="font-headings font-medium">
            <%= post.type.humanize(capitalize: false) %>
          </span>
        </span>
        from
        <% if !post.pen_name? && (world = post.author.world) %>
          <%= link_to(
            post.author.name,
            world_path(world),
            class: "rounded-xs font-semibold text-primary-500 hover:text-primary-600",
          ) %>
        <% else %>
          <span class="font-semibold">
            <%= post.pen_name||post.author.name %>
          </span>
        <% end %>
      </div>

      <%= local_time(
        post.created_at,
        format: :short,
        class: "font-headings lowercase",
      ) %>
    </div>

    <div class="post-card-content">
      <% if (title = post.title) %>
        <h3 class="text-lg leading-tight font-bold"><%= title %></h3>
      <% end %>

      <% if (body_html = post.body_html) %>
        <div class="prose dark:prose-invert max-w-none"><%== body_html -%></div>
      <% else %>
        <%= post.body -%>
      <% end %>
    </div>

    <% if allowed_to?(:manage?, post) %>
      <div class="post-card-footer">
        <div
          class="relative -mr-1 -mb-1"
          data-controller="dropdown"
          data-action="turbo:before-cache@document->dropdown#hide"
        >
          <button
            type="button"
            class="btn menu-btn"
            data-dropdown-target="trigger"
            data-action="dropdown#toggle"
            aria-haspopup="true"
          >
            <%= icon "pencil-square", variant: :micro, class: "size-4" %>
            <span>actions</span>
          </button>

          <div
            class="card dropdown-menu menu-card top-auto bottom-0 hidden"
            data-dropdown-target="menu"
          >
            <ul role="menu">
              <li role="presentation">
                <%= link_to(
                  polymorphic_path([:edit, post.space, post], emulate_native_app: 1),
                  role: "menuitem",
                  data: {
                    action: "dropdown#toggle"
                  }
                ) do %>
                  <%= icon "pencil", variant: :micro, class: "size-4" %>
                  <span class="font-headings text-sm">edit post</span>
                <% end %>
              </li>

              <li role="presentation">
                <%= button_to(
                  [post.space, post],
                  role: "menuitem",
                  method: :delete,
                  data: {
                    action: "dropdown#toggle alert-bridge#show",
                  },
                  form: {
                    class: "flex flex-col",
                    data: {
                      controller: "haptic-bridge",
                      action: "turbo:submit-end->haptic-bridge#vibrate",
                      busy_reporter_target: "busyable",
                      turbo_confirm: "really delete post?",
                    },
                  }
                ) do %>
                  <%= icon "trash", variant: :micro, class: "size-4" %>
                  <span class="font-headings text-sm">delete post</span>
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="post-card-loading_overlay">
    <div class="spinner"></div>
  </div>
<% end %>
