<div
  id="<%= dom_id(post, :card) %>"
  class="card post-card flex flex-col gap-2.5 shadow-sm"
>
  <div class="post-card-header flex gap-1 justify-between text-xs text-shade-500">
    <div class="flex items-baseline gap-1">
      <span class="inline-flex gap-1 items-baseline">
        <%= post_type_icon(post.type, class: "size-3 self-center") %>
        <span class="font-medium font-headings">
          <%= post.type.humanize(capitalize: false) %>
        </span>
      </span>
      <span>
        from
        <% if !post.pen_name? && (world = post.author.world) %>
          <%= link_to(
            post.author.name,
            world_path(world),
            class: "font-semibold text-primary-500 dark:text-primary-600",
          ) %>
        <% else %>
          <span class="font-semibold">
            <%= post.author.name %>
          </span>
        <% end %>
      </span>
    </div>
    <%= local_time(
      post.created_at,
      format: :short,
      class: "font-headings lowercase",
    ) %>
  </div>
  <div class="post-card-content">
    <% if (title = post.title) %>
      <h3 class="text-lg font-bold leading-tight"><%= title %></h3>
    <% end %>
    <% if (body_html = post.body_html) %>
      <div class="prose dark:prose-invert max-w-none">
        <%= body_html.html_safe %>
      </div>
    <% end %>
  </div>
</div>
