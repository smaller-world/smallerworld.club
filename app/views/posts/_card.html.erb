<% class_name = local_assigns.delete(:class) %>
<% delete_confirmation = "really delete post?" %>

<%= tag.div(
  id: dom_id(post, :card),
  class: class_names("card post-card", class_name),
  data: {
    controller: "busy-reporter",
  },
) do %>
  <div class="flex flex-col">
    <div class="post-card-header">
      <div class="flex items-baseline gap-1">
        <span class="inline-flex items-baseline gap-0.5">
          <%= post_type_icon(post.type, class: "size-3 self-center") %>

          <span class="font-headings font-medium">
            <%= post.type.humanize(capitalize: false) %>
          </span>
        </span>
        from
        <% if !post.pen_name? && (world = post.author.world) %>
          <%= link_to(
            post.author.name,
            world_path(world),
            class: "rounded-xs font-semibold text-primary-500 hover:text-primary-600",
          ) %>
        <% else %>
          <span class="font-semibold"><%= post.author.name %></span>
        <% end %>
      </div>

      <%= local_time(
        post.created_at,
        format: :short,
        class: "font-headings lowercase",
      ) %>
    </div>

    <div class="post-card-content">
      <% if (title = post.title) %>
        <h3 class="text-lg leading-tight font-bold"><%= title %></h3>
      <% end %>

      <% if (body_html = post.body_html) %>
        <div class="prose dark:prose-invert max-w-none"><%== body_html -%></div>
      <% else %>
        <%= post.body -%>
      <% end %>
    </div>

    <% if allowed_to?(:manage?, post) %>
      <div class="post-card-footer">
        <div data-controller="dropdown" class="relative">
          <button
            type="button"
            class="btn menu-btn relative top-1 left-1"
            data-dropdown-target="trigger"
            data-action="dropdown#toggle"
            aria-haspopup="true"
          >
            <%= icon "pencil-square", variant: :micro, class: "size-4" %>
            <span>actions</span>
          </button>

          <ul
            class="card menu-card hidden"
            role="menu"
            data-dropdown-target="menu"
          >
            <li role="presentation">
              <%= link_to(
                polymorphic_path([:edit, post.space, post], emulate_native_app: 1),
                role: "menuitem",
                data: {
                  action: "dropdown#toggle"
                }
              ) do %>
                <%= icon "pencil", variant: :micro, class: "size-4" %>
                <span class="font-headings text-sm">edit post</span>
              <% end %>
            </li>

            <li role="presentation">
              <%= button_to(
                [post.space, post],
                role: "menuitem",
                method: :delete,
                data: {
                  controller: "alert-bridge",
                  action: "dropdown#toggle alert-bridge#show",
                  bridge_title: delete_confirmation,
                  turbo_confirm: delete_confirmation,
                },
                form: {
                  class: "flex flex-col",
                  data:{
                    busy_reporter_target: "busyable",
                  },
                }
              ) do %>
                <%= icon "trash", variant: :micro, class: "size-4" %>
                <span class="font-headings text-sm">delete post</span>
              <% end %>
            </li>
          </ul>
        </div>
      </div>
    <% end %>
  </div>

  <div class="post-card-loading_overlay">
    <div class="spinner"></div>
  </div>
<% end %>
