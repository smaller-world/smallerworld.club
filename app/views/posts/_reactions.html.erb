<%= turbo_frame_tag dom_id(post, :reactions), class: "flex gap-1" do %>
  <% post_reaction_groups(post).each do |group| %>
    <% reacted = group.current_reaction_id.present? %>

    <%= post_reaction_group_button(
      group,
      class: "btn post_card-reaction",
      disabled: !allowed_to?(:react?, post),
      aria: {
        pressed: reacted,
      },
    ) do %>
      <span class="font-emoji text-base"><%= group.emoji %></span>
      <span class="font-headings text-xs leading-none"><%= group.count %></span>
    <% end %>
  <% end %>

  <% if allowed_to?(:react?, post) %>
    <%= form_with(
      model: post.reactions.build,
      url: post_reactions_path(post),
      class: "relative",
      data: {
        controller: "form modal emoji-picker",
      }
    ) do |form| %>
      <%= form.hidden_field :emoji, data: { emoji_picker_target: "input" } %>

      <%= form.button(
        class: "btn p-1 disabled:min-w-8",
        data: {
          action: "modal#open:prevent",
        },
      ) do %>
        <%= icon "face-smile-plus", library: :sidekickicons, class: "size-5" %>
      <% end %>

      <%= render(
        "overlays/modal_dialog",
        panel: {
          class: "overflow-hidden rounded-3xl p-0",
        },
      ) do %>
        <% tag.div(data: {
          controller: "emoji-mart",
          action: class_names(
            "turbo:before-cache@document->emoji-mart#teardown",
            "emoji-mart:select->emoji-picker#setEmoji",
            "emoji-mart:select->modal#close",
            "emoji-mart:select->form#submit",
          ),
        }) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
