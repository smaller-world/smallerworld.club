<%- class_name = local_assigns.delete(:class) -%>
<%- data = local_assigns.delete(:data) || {} -%>
<%- controller = data.delete(:controller) -%>
<%- error = form.object.errors.full_messages_for(field).first -%>
<%- input_attributes = local_assigns.delete(:input) || {} -%>

<%- input_attributes.merge!(delete_from(
  local_assigns,
  :value,
  :required,
)) -%>

<%- input_class = input_attributes.delete(:class) %>
<%- input_data = input_attributes.delete(:data) || {} -%>
<%- input_controller = input_data.delete(:controller) -%>
<%- input_action = input_data.delete(:action) -%>

<%= render(
  "forms/field_wrapper",
  class: class_names("emoji_field", class_name),
  data: {
    controller: class_names("emoji-picker", controller),
    **data,
  },
  **local_assigns,
) do %>
  <div class="relative" data-controller="modal">
    <%= form.text_field(
      field,
      class: class_names("form_input emoji_field_input", input_class),
      placeholder: "dummy",
      readonly: true,
      data: {
        controller: class_names("emoji-toggle-input", input_controller),
        action: class_names(
          "click->emoji-toggle-input#clearEmojiOrOpenPicker",
          "emoji-toggle-input:open-picker->modal#open",
          input_action,
        ),
        emoji_picker_target: "input",
        dropdown_target: "trigger",
        error: error.present?
      }.compact_blank,
      aria: {
        haspopup: true,
        controls: "menu",
        describedby: (form.field_id(field, "error") if error.present?),
      },
      **input_attributes,
    ) %>

    <div class="emoji_field_placeholder">
      <%= icon(
        "face-smile-plus",
        library: :sidekickicons,
        class: "size-6 text-shade-400 dark:text-shade-500",
      ) %>
    </div>

    <%= render(
      "overlays/modal_dialog",
      panel: {
        class: "overflow-hidden rounded-3xl p-0",
      },
    ) do %>
      <%= tag.div(data: {
        controller: "emoji-mart",
        action: class_names(
          "emoji-mart:select->emoji-picker#setEmoji",
          "emoji-mart:select->modal#close",
        ),
      }) %>
    <% end %>
  </div>
<% end %>
