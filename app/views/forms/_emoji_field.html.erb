<% class_name = local_assigns.delete(:class) %>
<% data = local_assigns.delete(:data) %>
<% error = form.object.errors.full_messages_for(name).first %>

<%= render(
  "forms/field_wrapper",
  class: class_names("emoji_field", class_name),
  data: {
    controller: "emoji-picker",
    **data,
  },
  **local_assigns,
) do %>
  <div
    class="relative"
    data-controller="dropdown"
    data-emoji-picker-target="dropdown"
  >
    <%= form.text_field(
      name,
      class: "form-input",
      placeholder: "dummy",
      data: {
        controller: "emoji-toggle-input",
        action: class_names(
          "click->emoji-input#openPickerOrClearEmoji",
          "emoji-toggle-input:open-picker->dropdown#toggle",
        ),
        emoji_picker_target: "input",
        dropdown_target: "trigger",
        error: error.present?
      }.compact_blank,
      aria: {
        haspopup: true,
        controls: "menu",
        describedby: (form.field_id(name, "error") if error.present?),
      },
      readonly: true,
      **local_assigns.slice(:required),
    ) %>

    <div class="emoji_field-placeholder">
      <%= icon(
        "face-smile-plus",
        library: :sidekickicons,
        class: "size-5 text-shade-400 dark:text-shade-500",
      ) %>
    </div>

    <%= tag.div(
      class: "dropdown_menu emoji_field-picker card hidden",
      role: "dialog",
      data: {
        controller: "emoji-mart",
        dropdown_target: "menu",
        action: class_names(
          "emoji-mart:select->emoji-field#setEmoji",
          "emoji-mart:select->dropdown#toggle"
        ),
      },
    ) %>
  </div>
<% end %>
