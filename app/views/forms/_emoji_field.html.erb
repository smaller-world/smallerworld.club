<% class_name = local_assigns.delete(:class) %>
<% data = local_assigns.delete(:data) %>
<% error = form.object.errors.full_messages_for(name).first %>

<%= render(
  "forms/field_wrapper",
  class: class_names("emoji_field", class_name),
  data: {
    controller: "emoji-picker",
    **data,
  },
  **local_assigns,
) do %>
  <div class="relative" data-controller="modal">
    <%= form.text_field(
      name,
      class: "form-input",
      placeholder: "dummy",
      data: {
        controller: "emoji-toggle-input",
        action: class_names(
          "click->emoji-toggle-input#clearEmojiOrOpenPicker",
          "emoji-toggle-input:open-picker->modal#open",
        ),
        emoji_picker_target: "input",
        dropdown_target: "trigger",
        error: error.present?
      }.compact_blank,
      aria: {
        haspopup: true,
        controls: "menu",
        describedby: (form.field_id(name, "error") if error.present?),
      },
      readonly: true,
      **local_assigns.slice(:required),
    ) %>

    <div class="emoji_field-placeholder">
      <%= icon(
        "face-smile-plus",
        library: :sidekickicons,
        class: "size-5 text-shade-400 dark:text-shade-500",
      ) %>
    </div>

    <%= render(
      "overlays/modal_dialog",
      panel: {
        class: "overflow-hidden rounded-3xl p-0",
      },
    ) do %>
      <%= tag.div(data: {
        controller: "emoji-mart",
        action: class_names(
          "turbo:before-cache@document->emoji-mart#teardown",
          "emoji-mart:select->emoji-picker#setEmoji",
          "emoji-mart:select->modal#close",
        ),
      }) %>
    <% end %>
  </div>
<% end %>
