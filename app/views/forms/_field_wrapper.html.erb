<%- description = local_assigns.delete(:description) -%>
<%- error = error_message_for(form.object, field) -%>

<%= tag.div(
  class: class_names("field_wrapper", local_assigns[:class]),
  **local_assigns.slice(:data),
) do %>
  <% if label != false || description %>
    <div>
      <% if !local_assigns.key?(:label) || local_assigns[:label] %>
        <%= form.label(
        field,
        local_assigns.fetch(:label) { field.to_s.humanize(capitalize: false) },
        class: class_names("field_wrapper_label", local_assigns[:label_class]),
      ) %>
      <% end %>

      <% if description %>
        <p class="field_wrapper_description"><%= description %></p>
      <% end %>
    </div>
  <% end %>

  <div class="relative flex flex-col items-stretch"><%= yield %></div>

  <% if error %>
    <%= tag.span(
      error,
      id: form.field_id(field, :error),
      class: class_names("field_wrapper_error", local_assigns[:error_class]),
    ) %>
  <% end %>
<% end %>
