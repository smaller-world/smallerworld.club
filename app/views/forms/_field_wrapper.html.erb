<% label = local_assigns.delete(:label) %>
<% description = local_assigns.delete(:description) %>
<% error = error_message_for(form.object, name) %>

<%= tag.div(
  class: class_names("field_wrapper", local_assigns[:class]),
  **local_assigns.slice(:data),
) do %>
  <% if label != false || description %>
    <div>
      <% unless label == false %>
        <%= form.label(
        name,
        label || name.to_s.humanize(capitalize: false),
        class: "block text-sm font-medium font-headings leading-tight"
      ) %>
      <% end %>

      <% if description %>
        <p class="text-shade-500 text-xs leading-[1.2]"><%= description %></p>
      <% end %>
    </div>
  <% end %>

  <div class="relative flex flex-col items-stretch"><%= yield %></div>

  <% if error %>
    <%= tag.span(
      error,
      id: form.field_id(name, :error),
      class: class_names("text-sm text-red-600", local_assigns[:error_class]),
    ) %>
  <% end %>
<% end %>
