<% class_name = local_assigns.delete(:class) %>
<% data = local_assigns.delete(:data) %>
<% label = local_assigns.delete(:label) %>
<% description = local_assigns.delete(:description) %>
<% error = form.object.errors.full_messages_for(name).first %>

<%= tag.div(
  class: class_names("field_wrapper", class_name),
  data:,
) do %>
  <% if label != false || description %>
    <div>
      <% unless label == false %>
        <%= form.label(
        name,
        label || name.to_s.humanize(capitalize: false),
        class: "block text-sm font-medium font-headings leading-tight"
      ) %>
      <% end %>

      <% if description %>
        <p class="text-shade-500 text-xs leading-[1.2]"><%= description %></p>
      <% end %>
    </div>
  <% end %>

  <div class="relative flex flex-col items-stretch"><%= yield %></div>

  <% if error %>
    <span class="text-sm text-red-600" id="<%= form.field_id(name, :error) %>">
      <%= error %>
    </span>
  <% end %>
<% end %>
