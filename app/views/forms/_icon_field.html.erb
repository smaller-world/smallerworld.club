<% class_name = local_assigns.delete(:class) %>
<% attachment = form.object.send(name) %>
<% error = form.object.errors.full_messages_for(name).first %>
<% center = local_assigns.delete(:center) %>
<% accept = local_assigns.delete(:accept) %>

<%= render(
  "forms/field_wrapper",
  class: class_names("icon_field", class_name),
  **local_assigns,
) do %>
  <%= tag.div(
    class: class_names(
      "form-input border-dashed size-36 mt-1",
      { "mx-auto" => center },
    ),
    data: {
      controller: "filepond haptic-bridge",
      action: class_names(
        "turbo:before-cache@document->filepond#teardown",
        "filepond:uploaded->haptic-bridge#vibrate",
      ),
      filepond_direct_upload_url_value: rails_direct_uploads_path,
      filepond_file_url_template_value: filepond_file_path(":signed_id"),
      filepond_aspect_ratio_value: "1:1",
      busy_reporter_target: "busyable",
    }
  ) do %>
    <%= form.hidden_field name, value: "" %>

    <%= form.hidden_field(
      name,
      value: (attachment.signed_id if attachment.attached?),
      data: {
        filepond_target: "input",
        error: error.present? ,
      }.compact_blank,
      aria: {
        describedby: (form.field_id(name, "error") if error.present?),
      },
      accept:,
    ) %>

    <template data-filepond-target="idleLabelTemplate">
      <div class="flex flex-col items-center gap-1.5">
        <%= icon "arrow-up-tray", variant: :micro, class: "size-5 text-shade-600" %>
        drag & drop your image here
      </div>
    </template>

    <%= render(
      "overlays/modal",
      class: "editor_modal",
      data: {
        filepond_target: "editorModal",
        action: class_names(
          "filepond:open-editor-modal->modal#open",
          "filepond:close-editor-modal->modal#close",
          "modal:opened->filepond#initializeCropper",
          "modal:cancelled->filepond#cancelEdit",
          "modal:closed->filepond#finalizeEdit",
        )
      },
    ) do %>
      <img data-filepond-target="editorModalImage" alt="">

      <div class="footer">
        <button
          type="button"
          class="btn action-btn text-sm"
          data-action="modal#close filepond#confirmEdit"
        >
          <span> crop and continue </span>
          <%= icon "arrow-right", variant: :micro, class: "size-4" %>
        </button>
      </div>
    <% end %>
  <% end %>
<% end %>
