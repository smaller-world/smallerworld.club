<%= render "forms/field_wrapper", class: "icon-field", **local_assigns do %>
  <% attachment = form.object.send(name) %>
  <% error = form.object.errors.full_messages_for(name).first %>
  <div
    class="<%= class_names(
      "form-input border-dashed size-36 mt-1",
      { "mx-auto" => local_assigns[:center] },
      local_assigns[:class]
    ) %>"
    data-controller="filepond"
    data-action="turbo:before-cache@document->filepond#teardown"
    data-filepond-direct-upload-url-value="<%= rails_direct_uploads_path %>"
    data-filepond-aspect-ratio-value="1:1"
    data-prevent-submit-while-busy-target="busyable"
  >
    <%= form.hidden_field name, value: "" %>
    <%= form.hidden_field(
      name,
      value: (attachment.signed_id if attachment.attached?),
      data: {
        filepond_target: "input",
        error: error.present? ,
      }.compact_blank,
      aria: {
        describedby: (form.field_id(name, "error") if error.present?),
      },
      **local_assigns.slice(:accept),
    ) %>
    <template data-filepond-target="idleLabelTemplate">
      <div class="flex flex-col items-center gap-1.5">
        <%= icon "arrow-up-tray", variant: :micro, class: "size-5 text-shade-600" %>
        drag & drop your image here
      </div>
    </template>
    <%= render(
      "overlays/modal",
      class: "editor-modal",
      data: {
        filepond_target: "editorModal",
        action: class_names(
          "filepond:open-editor-modal->modal#open",
          "filepond:close-editor-modal->modal#close",
          "modal:opened->filepond#initializeCropper",
          "modal:cancelled->filepond#cancelEdit",
          "modal:closed->filepond#finalizeEdit",
        )
      },
    ) do %>
      <img
        data-filepond-target="editorModalImage"
        alt=""
      >
      <div class="footer">
        <button
          type="button"
          class="btn btn-action text-sm"
          data-action="modal#close filepond#confirmEdit"
        >
          <span>
            crop and continue
          </span>
          <%= icon "arrow-right", variant: :micro, class: "size-4" %>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
