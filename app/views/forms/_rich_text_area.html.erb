<% class_name = local_assigns.delete(:class) %>
<% required = local_assigns.delete(:required) %>
<% placeholder = local_assigns.delete(:placeholder) %>
<% error = form.object.errors.full_messages_for(name).first %>

<%= render(
  "forms/field_wrapper",
  class: class_names("rich_text_area", class_name),
  **local_assigns,
) do %>
  <%= form.rich_text_area(
    name,
    class: "form-textarea lexxy-content max-w-none",
    data: {
      error: error.present? ,
    }.compact_blank,
    aria: {
      describedby: (form.field_id(name, "error") if error.present?),
    },
    attachment: false,
    required:,
    placeholder:,
  ) %>
<% end %>
