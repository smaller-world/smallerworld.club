<%- class_name = local_assigns.delete(:class) -%>
<%- error = form.object.errors.full_messages_for(name).first -%>

<%= render(
  "forms/field_wrapper",
  class: class_names("text-area", class_name),
  **local_assigns,
) do %>
  <%= form.text_area(
    name,
    class: "form-textarea p-2",
    data: {
      controller: "textarea-autogrow",
      error: error.present? ,
    }.compact_blank,
    aria: {
      describedby: (form.field_id(name, "error") if error.present?),
    },
    **local_assigns.slice(:required, :placeholder),
  ) %>
<% end %>
