<%- class_name = local_assigns.delete(:class) -%>
<%- error = form.object.errors.full_messages_for(name).first -%>
<%- input_attributes = local_assigns.delete(:input) || {} -%>

<%- input_attributes.merge!(delete_from(
  local_assigns,
  :required,
  :placeholder,
  :value,
)) -%>

<%- input_class = input_attributes.delete(:class) %>
<%- input_data = input_attributes.delete(:data) || {} -%>
<%- input_controller = input_attributes.delete(:controller) -%>

<%= render(
  "forms/field_wrapper",
  class: class_names("text-area", class_name),
  **local_assigns,
) do %>
  <%= form.text_area(
    name,
    class: class_names("form-textarea p-2", input_class),
    data: {
      controller: class_names("textarea-autogrow", input_controller),
      error: error.present? ,
      **input_data,
    }.compact_blank,
    aria: {
      describedby: (form.field_id(name, "error") if error.present?),
    },
    **input_attributes,
  ) %>
<% end %>
