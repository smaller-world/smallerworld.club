<% data = local_assigns.delete(:data) || {} %>
<% controller = data.delete(:controller) %>
<% action = data.delete(:action) %>
<% panel_options = local_assigns.delete(:panel_options) || {} %>
<% panel_class = panel_options.delete(:class) %>

<%= tag.dialog(
  class: class_names("modal", local_assigns[:class]),
  data: {
    controller: class_names("modal", controller),
    action: class_names("cancel->modal#onDialogCancel", action),
    **data,
  }
) do %>
  <div class="modal-backdrop" data-modal-target="backdrop"></div>

  <div class="modal-container">
    <%= tag.div(
      class: class_names("modal-panel", panel_class),
      data: {
        modal_target: "panel",
        **panel_options.delete(:data)
      },
      tabindex: "-1",
      **panel_options
    ) do %>
      <%= yield %>
    <% end %>
  </div>
<% end %>
