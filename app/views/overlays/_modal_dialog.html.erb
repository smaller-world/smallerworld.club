<% data = local_assigns.delete(:data) || {} %>
<% action = data.delete(:action) %>
<% panel_options = local_assigns.delete(:panel) || {} %>
<% panel_class = panel_options.delete(:class) %>

<%= tag.dialog(
  class: class_names("modal_dialog", local_assigns[:class]),
  data: {
    modal_target: "dialog",
    action: class_names(
      "turbo:before-cache@document->modal#teardown",
      "cancel->modal#onDialogCancel",
      action,
    ),
    **data,
  }
) do %>
  <div class="modal_backdrop" data-modal-target="backdrop"></div>

  <div class="modal_container">
    <%= tag.div(
      class: class_names("modal_panel", panel_class),
      data: {
        modal_target: "panel",
        **panel_options.delete(:data)
      },
      tabindex: "-1",
      **panel_options
    ) do %>
      <%= yield %>
    <% end %>
  </div>
<% end %>
