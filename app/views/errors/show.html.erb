<div class="page_container flex-1 flex flex-col items-center justify-center gap-3">
  <div class="badge">status <%= @status_code %></div>

  <h1 class="text-2xl font-semibold"><%= @title %></h1>

  <p class="text-shade-dimmed leading-tight"><%= @description %></p>

  <% if @error.present? %>
    <code class="rounded-3xl p-2 card">error: <%= @error %></code>
  <% end %>
</div>
