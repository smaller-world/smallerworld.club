<div class="page_container flex flex-col gap-6">
  <%= back_link_to(
    @world.name,
    user_world_path(emulate_native_app: 1),
    class: "self-center",
  ) do %>
    <%= icon "arrow-uturn-left", variant: :micro, class: "size-5" %>
    <span class="overflow-ellipsis">back to <%= @world.name %></span>
  <% end %>

  <%= turbo_frame_tag dom_id(@post, :edit), target: "_top" do %>
    <%= render "worlds/posts/form", post: @post %>
  <% end %>
</div>
