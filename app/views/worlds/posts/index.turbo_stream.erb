<%= turbo_stream.append :posts do %>
  <% @posts.each do |post| %>
    <li><%= render "posts/card", post: %></li>
  <% end %>
<% end %>

<% if (page = @pagy.next) %>
  <%= turbo_stream.replace :pagination do %>
    <%= render "worlds/pagination_button", world: @world, page: %>
  <% end %>
<% else %>
  <%= turbo_stream.remove :pagination %>
<% end %>
