<% class_name = local_assigns.delete(:class) %>
<% title_placeholder = post_title_placeholder(type: post.type) %>

<%= form_with(
  model: post,
  url: post.new_record? ? user_world_posts_path : user_world_post_path(post),
  class: class_names("flex flex-col gap-6", class_name),
  data: {
    controller: "busy-reporter haptic-bridge",
    action: "turbo:submit-end->haptic-bridge#vibrate",
  },
) do |form| %>
  <%= form.hidden_field :type %>

  <% form.object.hidden_from_ids.each do |id| %>
    <%= form.hidden_field :hidden_from_ids, value: id, multiple: true %>
  <% end %>

  <div class="flex flex-col gap-4">
    <div class="flex flex-col gap-2">
      <div>
        <% if title_placeholder %>
          <div class="post_form_emoji_hint mb-1 ml-3 flex items-center gap-1.5">
            <%= icon(
            "arrow-bend-left-down",
            library: :phosphor,
            fill: "currentColor",
            class: "size-5 mt-3",
          ) %>

            <span class="font-cursive">tag your post with an emoji</span>
          </div>
        <% end %>

        <div class="<%= class_names("flex gap-2", "items-center": !title_placeholder) %>">
          <%= render(
            "forms/emoji_field",
            form:,
            field: :emoji,
            label: nil,
          ) %>

          <% if title_placeholder %>
            <%= render(
          "forms/text_field",
          form:,
          field: :title,
          label: nil,
          placeholder: title_placeholder,
          class: "flex-1",
        ) %>
          <% else %>
            <div class="post_form-emoji_hint flex items-center gap-1">
              <%= icon "arrow-long-left", class: "size-5" %>
              <span class="font-cursive">tag your post with an emoji</span>
            </div>
          <% end %>
        </div>
      </div>

      <%= render(
      "forms/rich_text_area",
      form:,
      field: :body,
      label: nil,
      value: post.body_html || post.body&.to_trix_html,
      placeholder: post_body_placeholder(type: post.type),
      required: true,
    ) %>
    </div>

    <%= render(
      "forms/field_wrapper",
      form:,
      field: :visibility,
      label: "who can see this post?",
    ) do %>
      <%= form.select(
        :visibility,
        options_for_select(post_visibility_options, "friends"),
        {},
        { class: "form_select" },
      ) %>
    <% end %>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.button class: "btn btn-action text-xl py-2.5" do %>
      <span><%= post.new_record? ? "post" : "save changes" %></span>

      <% if post.new_record? %>
        <%= icon "paper-airplane", variant: :micro, class: "size-5" %>
      <% end %>
    <% end %>
  </div>
<% end %>
