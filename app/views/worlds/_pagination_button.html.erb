<%= button_to(
  [world, :posts],
  method: :get,
  class: "btn",
  form: {
    id: :pagination,
    class: "self-center overflow-anchor-none",
    data: { turbo_stream: true },
  },
  params: {
    emulate_native_app: 1,
    page:,
    friend_token: current_friend&.access_token,
  }.compact,
  data: {
    controller: "click-on-appear",
    action: "click-on-appear:appear->click-on-appear#click",
  },
) do %>
  <span class="text-xs">see more posts...</span>
<% end %>
