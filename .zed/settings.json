{
  "context_servers": {
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=tttkkdzhzvelxmbcqvlg&read_only=true&features=docs%2Cdatabase"
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp/smallerworld/smallerworld_v2"
    }
  },
  "file_types": {
    "Ruby": ["rbi"]
  },
  "languages": {
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "rubocop",
        "sorbet",
        "tailwindcss-language-server",
        "!solargraph"
      ],
      "formatter": "language_server",
      "tab_size": 2
    },
    "JSON": {
      "formatter": "prettier"
    },
    "JavaScript": {
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TypeScript": {
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "Markdown": {
      "formatter": "prettier"
    }
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classRegex": [
            "class:\\s*['\"]([^'\"]*)['\"]",
            "transition_enter:\\s*['\"]([^'\"]*)['\"]",
            "transition_enter_start:\\s*['\"]([^'\"]*)['\"]",
            "transition_enter_end:\\s*['\"]([^'\"]*)['\"]",
            "transition_leave:\\s*['\"]([^'\"]*)['\"]",
            "transition_leave_start:\\s*['\"]([^'\"]*)['\"]",
            "transition_leave_end:\\s*['\"]([^'\"]*)['\"]",
            ["class_names\\(([^)]*)\\)", "[\"']([^\"']*)[\"']"]
          ]
        }
      }
    }
  }
}
